COORDINATOR_API_TOKEN=replace-with-a-long-random-token
# PostgreSQL runtime connection. Production should inject this from the secret manager.
AI_AGENT_COORDINATOR_DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_agent_coordinator
# dpm uses a separate non-production server/database for materialization and verification.
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Legacy/default secret for issue, pull-request, and workflow-run events.
GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
# Multi-organization push ingestion uses a unique secret per organization.
# Map organization names to environment-variable names; never put secret values here.
GITHUB_WEBHOOK_ORG_SECRET_ENVS=sonus-auris=GITHUB_WEBHOOK_SECRET_SONUS_AURIS,daedalus-fab=GITHUB_WEBHOOK_SECRET_DAEDALUS_FAB
GITHUB_WEBHOOK_SECRET_SONUS_AURIS=
GITHUB_WEBHOOK_SECRET_DAEDALUS_FAB=
# Push processing is fail-closed until explicitly enabled with an allowlist.
GITHUB_AUTO_ENQUEUE_PUSHES=false
GITHUB_PUSH_ALLOWED_REPOSITORIES=sonus-auris/sonus-auris-site.web,daedalus-fab/daedalus-clients
GITHUB_PUSH_DEFAULT_BRANCHES=sonus-auris/sonus-auris-site.web=main,daedalus-fab/daedalus-clients=main
# Linear delivery is a separate protected phase. It is disabled and dry-run by default.
LINEAR_DELIVERY_ENABLED=false
LINEAR_DELIVERY_DRY_RUN=true
LINEAR_API_URL=https://api.linear.app/graphql
# Personal API keys use api_key; OAuth access tokens use bearer.
LINEAR_API_AUTH_SCHEME=api_key
# Secret-manager/environment only. Never pass this value as a CLI flag.
LINEAR_API_TOKEN=
LINEAR_TEAM_KEY=DEN
# Exact GitHub organization to Linear project-name map.
LINEAR_PROJECT_NAMES=sonus-auris=github.com/sonus-auris,daedalus-fab=github.com/daedalus-fab
# Optional exact per-org state IDs for closing directives.
LINEAR_COMPLETED_STATE_IDS=sonus-auris=replace-with-completed-state-uuid,daedalus-fab=replace-with-completed-state-uuid
LINEAR_REQUEST_TIMEOUT_MS=10000
LINEAR_MAX_RESPONSE_BYTES=262144
LINEAR_MAX_RETRIES=3
LINEAR_MIN_ORG_INTERVAL_MS=100

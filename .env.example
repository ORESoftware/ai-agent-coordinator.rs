COORDINATOR_API_TOKEN=replace-with-a-long-random-token
# Legacy/default secret for issue, pull-request, and workflow-run events.
GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
# Multi-organization push ingestion uses a unique secret per organization.
# Map organization names to environment-variable names; never put secret values here.
GITHUB_WEBHOOK_ORG_SECRET_ENVS=sonus-auris=GITHUB_WEBHOOK_SECRET_SONUS_AURIS,daedalus-fab=GITHUB_WEBHOOK_SECRET_DAEDALUS_FAB
GITHUB_WEBHOOK_SECRET_SONUS_AURIS=
GITHUB_WEBHOOK_SECRET_DAEDALUS_FAB=
# Push processing is fail-closed until explicitly enabled with an allowlist.
GITHUB_AUTO_ENQUEUE_PUSHES=false
GITHUB_PUSH_ALLOWED_REPOSITORIES=sonus-auris/sonus-auris-site.web,daedalus-fab/daedalus-clients
GITHUB_PUSH_DEFAULT_BRANCHES=sonus-auris/sonus-auris-site.web=main,daedalus-fab/daedalus-clients=main
# Repository creation is fail-closed. Leave disabled until a dry run is reviewed.
GITHUB_REPOSITORY_ADMIN_ENABLED=false
# Use a short-lived GitHub App installation token with repository Administration: write.
GITHUB_REPOSITORY_ADMIN_TOKEN=
# Comma-separated exact organization allowlist, for example declarative-migrations,rust-ssr-demos
GITHUB_REPOSITORY_ADMIN_ALLOWED_ORGS=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_API_USER_AGENT=ai-agent-coordinator
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
RUST_LOG=ai_agent_coordinator=info,tower_http=info

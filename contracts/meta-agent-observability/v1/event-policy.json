    "success_criterion_updated",
    "task_created",
    "task_started",
    "task_progressed",
    "task_blocked",
    "task_completed",
    "task_failed",
    "task_canceled",
    "dependency_changed",
    "plan_proposed",
    "plan_revised",
    "tool_requested",
    "tool_started",
    "tool_completed",
    "tool_failed",
    "observation_recorded",
    "evidence_referenced",
    "decision_recorded",
    "confidence_updated",
    "assumption_declared",
    "risk_declared",
    "critique_recorded",
    "reflection_recorded",
    "lesson_recorded",
    "context_requested",
    "context_responded",

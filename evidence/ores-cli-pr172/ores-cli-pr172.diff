+fn audit_peer_authority_evidence(root: &Path, report: &mut CommandReport) {
+    let typespec = read_evidence_file(root, TYPESPEC_AUTHORITY, "TypeSpec", report);
+    let schema = read_evidence_file(root, JSON_SCHEMA_AUTHORITY, "JSON Schema", report);
+
+    match (typespec, schema) {
+        (EvidenceFile::Missing, EvidenceFile::Missing) => {
+            report.push(
+                Finding::info(
+                    "otel-peer-authority-external",
+                    "repository does not vendor OTel authority evidence; bounded lint assumes the owner TypeSpec and authored JSON Schema remain external peer authorities",
+                )
+                .with_target(CONFIG),
+            );
+        }
+        (EvidenceFile::Present(_), EvidenceFile::Missing)
+        | (EvidenceFile::Missing, EvidenceFile::Present(_)) => {
+            error(
+                report,
+                "otel-peer-authority-incomplete",
+                "vendored OTel authority evidence must contain both human-authored TypeSpec and independently authored JSON Schema Draft 2020-12",
+                "validation/evidence/ores-otel-config-v1",
+            );
+        }
+        (EvidenceFile::Present(typespec), EvidenceFile::Present(schema)) => {
+            audit_typespec_authority(&typespec, report);
+            audit_json_schema_authority(&schema, report);
+            audit_tjsv_workflow(root, report);
+        }
+        (EvidenceFile::Invalid, _) | (_, EvidenceFile::Invalid) => {}
+    }
+}
+
+fn audit_typespec_authority(text: &str, report: &mut CommandReport) {
+    for marker in [
+        "namespace OresOtel;",
+        "@id(\"OresOtelConfigV1\")",
+        "model OresOtelConfigV1",
+    ] {
+        if !text.contains(marker) {
+            error(
+                report,
+                "otel-typespec-authority-shape",
+                "vendored TypeSpec must expose the OresOtelConfigV1 peer-authority declaration",
+                TYPESPEC_AUTHORITY,
+            );
+            return;
+        }
+    }
+}
+
+fn audit_json_schema_authority(text: &str, report: &mut CommandReport) {
+    let Ok(value) = serde_json::from_str::<JsonValue>(text) else {
+        error(
+            report,
+            "otel-json-schema-authority-shape",
+            "vendored authored JSON Schema must parse as JSON",
+            JSON_SCHEMA_AUTHORITY,
+        );
+        return;
+    };
+    if value.get("$schema").and_then(JsonValue::as_str)
+        != Some("https://json-schema.org/draft/2020-12/schema")
+        || value
+            .get("$defs")
+            .and_then(JsonValue::as_object)
+            .and_then(|definitions| definitions.get("OresOtelConfigV1"))
+            .is_none()
+    {
+        error(
+            report,
+            "otel-json-schema-authority-shape",
+            "vendored JSON Schema peer authority must be Draft 2020-12 and define OresOtelConfigV1 independently of generated Schema B",
+            JSON_SCHEMA_AUTHORITY,
+        );
+    }
+}
+
+fn audit_tjsv_workflow(root: &Path, report: &mut CommandReport) {
+    let workflow = match read_evidence_file(root, TJSV_WORKFLOW, "TJSV workflow", report) {
+        EvidenceFile::Present(workflow) => workflow,
+        EvidenceFile::Missing => {
+            error(
+                report,
+                "otel-tjsv-workflow-missing",
+                "vendored OTel peer authorities require a repository workflow that runs TJSV against both authored inputs",
+                TJSV_WORKFLOW,
+            );
+            return;
+        }
+        EvidenceFile::Invalid => return,
+    };
+
+    let issues_before = report.issue_count();
+    if !has_immutable_tjsv_action(&workflow) {
+        error(
+            report,
+            "otel-tjsv-workflow-pin",
+            "TJSV must be referenced at an immutable 40-character Git commit SHA",
+            TJSV_WORKFLOW,
+        );
+    }
+
+    for (marker, purpose) in [
+        (
+            &format!("typespec: {TYPESPEC_AUTHORITY}"),
+            "human-authored TypeSpec input",
+        ),
+        (
+            &format!("schema: {JSON_SCHEMA_AUTHORITY}"),
+            "independently authored JSON Schema input",
+        ),
+    ] {
+        if !workflow.contains(marker) {
+            error(
+                report,
+                "otel-tjsv-workflow-input",
+                &format!("TJSV workflow must name the {purpose}"),
+                TJSV_WORKFLOW,
+            );
+        }
+    }
+
+    for key in ["instances:", "report:", "contract_ir:", "output_dir:"] {
+        if !workflow
+            .lines()
+            .any(|line| line.trim_start().starts_with(key))
+        {
+            error(
+                report,
+                "otel-tjsv-workflow-evidence",
+                "TJSV workflow must retain differential instances, parity report, Contract IR, and generated Schema B evidence",
+                TJSV_WORKFLOW,
+            );
+        }
+    }
+
+    if report.issue_count() == issues_before {
+        report.push(
+            Finding::info(
+                "otel-peer-authorities-wired",
+                "TypeSpec and authored JSON Schema are first-class independent peers; pinned TJSV is wired to transpile TypeSpec to comparison Schema B, compare Schema B with authored Schema A, and retain differential evidence",
+            )
+            .with_target(TJSV_WORKFLOW),
+        );
+    }
+}
+
+fn has_immutable_tjsv_action(workflow: &str) -> bool {
+    workflow.lines().any(|line| {
+        let Some(rest) = line.trim().strip_prefix("uses: ") else {
+            return false;
+        };
+        let Some(revision) = rest.strip_prefix(TJSV_ACTION) else {
+            return false;
+        };
+        let revision = revision.split_whitespace().next().unwrap_or_default();
+        revision.len() == 40
+            && revision
+                .bytes()
+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    })
+}
+
+#[derive(Debug)]
+enum EvidenceFile {
+    Missing,
+    Invalid,
+    Present(String),
+}
+
+fn read_evidence_file(
+    root: &Path,
+    relative: &str,
+    label: &str,
+    report: &mut CommandReport,
+) -> EvidenceFile {
+    let path = root.join(relative);
+    let metadata = match fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return EvidenceFile::Missing,
+        Err(_) => {
+            error(
+                report,
+                "otel-peer-authority-unreadable",
+                &format!("{label} evidence metadata could not be read"),
+                relative,
+            );
+            return EvidenceFile::Invalid;
+        }
+    };
+    if metadata.file_type().is_symlink() || !metadata.is_file() {
+        error(
+            report,
+            "otel-peer-authority-file",
+            &format!("{label} evidence must be a regular non-symlink file"),
+            relative,
+        );
+        return EvidenceFile::Invalid;
+    }
+    if metadata.len() > MAX_EVIDENCE_BYTES {
+        error(
+            report,
+            "otel-peer-authority-size",
+            &format!("{label} evidence exceeds the 1 MiB audit bound"),
+            relative,
+        );
+        return EvidenceFile::Invalid;
+    }
+    match fs::read_to_string(path) {
+        Ok(text) if text.trim().is_empty() => {
+            error(
+                report,
+                "otel-peer-authority-empty",
+                &format!("{label} evidence must not be empty"),
+                relative,
+            );
+            EvidenceFile::Invalid
+        }
+        Ok(text) => EvidenceFile::Present(text),
+        Err(_) => {
+            error(
+                report,
+                "otel-peer-authority-unreadable",
+                &format!("{label} evidence could not be read as UTF-8"),
+                relative,
+            );
+            EvidenceFile::Invalid
+        }
+    }
+}

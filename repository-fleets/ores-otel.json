    },
    {
      "name": "ores-otel-log-wasm-test",
      "language": "wasm",
      "runtime": "WebAssembly Component Model and WASI Preview 2",
      "test_command": "cargo test --manifest-path sdk/wasm/Cargo.toml",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency", "wasm-host"]
    },
    {
      "name": "ores-otel-log-wire-interop-test",
      "language": "wire-interop",

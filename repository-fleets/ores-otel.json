{
  "schema_version": 1,
  "canonical": {
    "source": "ORESoftware/next-loggers.ts",
    "target": "ores-otel/ores.otel.log",
    "default_branch": "main"
  },
  "test_organization": "ores-otel-test",
  "visibility": "public",
  "repositories": [
    {
      "name": "ores-otel-log-nodejs-test",
      "language": "nodejs",
      "runtime": "Node.js, Bun, and Deno",
      "test_command": "npm ci && npm test",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "supabase-client", "lifecycle", "concurrency", "prometheus-cardinality", "loki-correlation"]
    },
    {
      "name": "ores-otel-log-browser-test",
      "language": "browser",
      "runtime": "Browser and workerd",
      "test_command": "npm ci && npm run test:runtimes",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "supabase-client", "lifecycle", "browser-exit"]
    },
    {
      "name": "ores-otel-log-python-test",
      "language": "python",
      "runtime": "CPython 3.11-3.14",
      "test_command": "python -m unittest discover -s sdk/python/tests -v",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "supabase-client", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-go-test",
      "language": "go",
      "runtime": "Go 1.24+",
      "test_command": "go test -race ./...",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-rust-test",
      "language": "rust",
      "runtime": "Rust stable",
      "test_command": "cargo test --manifest-path sdk/rust/Cargo.toml",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-java-test",
      "language": "java",
      "runtime": "JDK 21+",
      "test_command": "bash sdk/java/test.sh",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-dart-test",
      "language": "dart",
      "runtime": "Dart and Flutter stable",
      "test_command": "dart analyze && dart test",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "supabase-client", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-gleam-test",
      "language": "gleam",
      "runtime": "Gleam on BEAM",
      "test_command": "gleam format --check src test && gleam test",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-erlang-test",
      "language": "erlang",
      "runtime": "Erlang/OTP",
      "test_command": "bash sdk/erlang/test.sh",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-elixir-test",
      "language": "elixir",
      "runtime": "Elixir on OTP",
      "test_command": "bash sdk/elixir/test.sh",
      "capabilities": ["record-schema", "api-manifest", "context-isolation", "otel-explicit", "no-monkey-patching", "lifecycle", "concurrency"]
    },
    {
      "name": "ores-otel-log-ruby-test",
      "language": "ruby",
      "runtime": "Ruby 3.4+",
      "test_command": "ruby sdk/ruby/test/next_loggers_test.rb",

      "auth_required": true,
      "request_id_required": true,
      "idempotency_key": "forbidden",
      "conditional_header": "If-None-Match",
      "retry_class": "safe_read",
      "streaming_request": false,
      "streaming_response": false,
      "sensitive_response_fields": ["storage_locations", "ocr_text", "caption"]
    },
    {
      "operation_id": "searchAssets",
      "method": "POST",
      "path_template": "/v1/search",
      "request_content_type": "application/json",
      "success_statuses": [200],
      "auth_required": true,
      "request_id_required": true,
      "idempotency_key": "optional",
      "conditional_header": null,
      "retry_class": "safe_read",
      "streaming_request": false,
      "streaming_response": false,
      "sensitive_response_fields": ["ocr", "caption", "provider_reference"]
    },
    {

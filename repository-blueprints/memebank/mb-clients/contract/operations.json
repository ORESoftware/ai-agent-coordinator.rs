      "auth_required": true,
      "request_id_required": true,
      "idempotency_key": "optional",
      "conditional_header": null,
      "retry_class": "idempotent_write",
      "streaming_request": false,
      "streaming_response": false,
      "sensitive_response_fields": ["authenticated_handoff"]

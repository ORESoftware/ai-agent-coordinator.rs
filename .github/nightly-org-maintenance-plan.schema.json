{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORESoftware/ai-agent-coordinator.rs/.github/nightly-org-maintenance-plan.schema.json",
  "title": "Nightly organization maintenance plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "owner",
    "summary",
    "new_pr_tasks",
    "merge_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "nightly_org_plan.v1"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "new_pr_tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "title",
          "goal",
          "acceptance",
          "linear_issue",
          "risk",
          "protected_area",
          "source_pr"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          },
          "goal": {
            "type": "string",
            "minLength": 20,
            "maxLength": 4000
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "linear_issue": {
            "type": "string",
            "maxLength": 50
          },
          "risk": {
            "enum": ["low", "medium"]
          },
          "protected_area": {
            "type": "boolean"
          },
          "source_pr": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["repository", "number", "head_sha"],
                "properties": {
                  "repository": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
                  },
                  "number": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "head_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "merge_candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "number",
          "head_sha",
          "action",
          "rationale"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "action": {
            "enum": [
              "merge_if_green",
              "repair_with_replacement_pr",
              "skip"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          }
        }
      }
    }
  }
}
